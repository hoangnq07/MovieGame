# MOVIEGAME Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=5000
APP_NAME=MOVIEGAME
APP_VERSION=1.0.0
APP_URL=https://yourdomain.com

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=warn
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Generate a strong JWT secret: openssl rand -base64 64
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=24h

# Generate a strong session secret: openssl rand -base64 64
SESSION_SECRET=your_super_secure_session_secret_minimum_32_characters_long

# CORS settings
CORS_ORIGIN=https://yourdomain.com
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=moviegame-9a57e
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@moviegame-9a57e.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_ID=your_private_key_id_from_firebase_json
# Note: Replace \n with actual newlines in the private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_ID=your_client_id_from_firebase_json
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40moviegame-9a57e.iam.gserviceaccount.com

# Firebase Client Configuration (for frontend)
FIREBASE_API_KEY=AIzaSyAqbuTEIvKsjodC4rvDTtfS6gdcY4vmk44
FIREBASE_AUTH_DOMAIN=moviegame-9a57e.firebaseapp.com
FIREBASE_STORAGE_BUCKET=moviegame-9a57e.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=151527639810
FIREBASE_APP_ID=11:151527639810:web:8f20331c368bdb2911901b

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# Weather API Configuration
WEATHER_API_KEY=your_production_weather_api_key_here
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1

# Movie Database API Configuration
MOVIE_DB_API_KEY=your_production_movie_db_api_key_here
MOVIE_DB_BASE_URL=https://api.themoviedb.org/3

# ZenQuotes API (usually no key required)
ZENQUOTES_API_BASE_URL=https://zenquotes.io/api

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Configuration (if using in addition to Firebase)
DATABASE_URL=postgresql://username:password@localhost:5432/moviegame_prod
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moviegame_prod
DB_USER=moviegame_user
DB_PASSWORD=your_secure_database_password
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# =============================================================================
# REDIS CONFIGURATION (for caching and sessions)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_TTL=3600

# =============================================================================
# EMAIL CONFIGURATION (for notifications)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# AWS CONFIGURATION (for file uploads, backups, etc.)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=moviegame-uploads
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# =============================================================================
# MONITORING AND ANALYTICS
# =============================================================================
# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# New Relic for performance monitoring
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=MOVIEGAME-Production

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_RATE_LIMITING=true
ENABLE_CACHING=true
ENABLE_ANALYTICS=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Cache settings
CACHE_TTL=300
CACHE_MAX_SIZE=100

# Request timeout settings
REQUEST_TIMEOUT=30000
UPLOAD_MAX_SIZE=10485760

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
SSL_REDIRECT=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=moviegame-backups

# =============================================================================
# DEVELOPMENT/DEBUG SETTINGS (set to false in production)
# =============================================================================
DEBUG=false
VERBOSE_LOGGING=false
ENABLE_CORS_DEBUG=false
TRUST_PROXY=true
